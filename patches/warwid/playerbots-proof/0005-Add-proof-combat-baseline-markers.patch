+uint32 CountProofNearbyHostiles(std::vector<Player*> const& proofBots, float range)
+{
+    std::vector<ObjectGuid> seenTargets;
+    for (Player* bot : proofBots)
+    {
+        if (!bot || !bot->IsInWorld() || !bot->IsAlive())
+            continue;
+
+        std::list<Unit*> targets;
+        Acore::AnyUnfriendlyUnitInObjectRangeCheck check(bot, bot, range);
+        Acore::UnitListSearcher<Acore::AnyUnfriendlyUnitInObjectRangeCheck> searcher(bot, targets, check);
+        Cell::VisitObjects(bot, searcher, range);
+
+        for (Unit* target : targets)
+        {
+            if (!target || !target->IsInWorld() || !target->IsAlive() || target->IsPlayer())
+                continue;
+            if (target->GetMapId() != bot->GetMapId() || target->GetInstanceId() != bot->GetInstanceId() ||
+                !bot->IsValidAttackTarget(target) || !bot->IsWithinLOSInMap(target))
+                continue;
+
+            ObjectGuid const guid = target->GetGUID();
+            if (std::find(seenTargets.begin(), seenTargets.end(), guid) == seenTargets.end())
+                seenTargets.push_back(guid);
+        }
+    }
+    return seenTargets.size();
+}
 }
 
