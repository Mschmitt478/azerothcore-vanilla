+bool RandomPlayerbotMgr::HandleProofDungeonCommand(ChatHandler* handler, std::string const& args)
+{
+    if (!sPlayerbotAIConfig.proofDungeonCommand)
+    {
+        handler->PSendSysMessage("Proof dungeon command is disabled. Set AiPlayerbot.ProofDungeonCommand = 1 in this proof tree.");
+        LOG_WARN("playerbots", "PLAYERBOTS_PROOF_DUNGEON disabled args='{}'", args);
+        return false;
+    }
+
+    std::istringstream input(args);
+    std::string dungeonToken;
+    uint32 groupSize = 0;
+    input >> dungeonToken >> groupSize;
+    uint32 runId = 0;
+    std::vector<uint8> requestedClasses;
+    std::string optionToken;
+    while (input >> optionToken)
+    {
+        if (uint32 const parsedRunId = ParseProofRunId(optionToken))
+        {
+            runId = parsedRunId;
+            continue;
+        }
+
+        uint8 const requestedClass = ProofClassId(optionToken);
+        if (!requestedClass)
+        {
+            handler->PSendSysMessage("Unknown proof dungeon class or option '{}'. Use run=<id> and class names like warrior/priest/mage.", optionToken);
+            return false;
+        }
+        requestedClasses.push_back(requestedClass);
+    }
+
+    if (dungeonToken.empty() || groupSize < 1 || groupSize > MAXGROUPSIZE ||
+        (!requestedClasses.empty() && requestedClasses.size() != groupSize))
+    {
+        handler->PSendSysMessage("Usage: playerbots rndbot proofdungeon <rfc|deadmines|lfgId|mapId|name> <groupSize 1-5> [run=<id>] [class ...]");
+        return false;
+    }
+
+    lfg::LFGDungeonData const* dungeon = ResolveProofDungeon(dungeonToken);
+    if (!dungeon)
+    {
+        handler->PSendSysMessage("Proof dungeon '{}' was not found in LFG dungeon data.", dungeonToken);
+        LOG_WARN("playerbots", "PLAYERBOTS_PROOF_DUNGEON missing_dungeon token='{}'", dungeonToken);
+        return false;
+    }
+
+    if (dungeon->x == 0.0f && dungeon->y == 0.0f && dungeon->z == 0.0f)
+    {
+        handler->PSendSysMessage("Proof dungeon '{}' resolved to LFG id {} but has no lfg_dungeon_template coordinates.",
+                                 dungeonToken, dungeon->id);
+        LOG_WARN("playerbots", "PLAYERBOTS_PROOF_DUNGEON missing_coordinates dungeon={} map={}", dungeon->id, dungeon->map);
+        return false;
+    }
+
+    if (rndBotTypeAccounts.empty())
+        AssignAccountTypes();
+
+    auto holdProofDungeonBot = [this](ObjectGuid::LowType botGuid)
+    {
+        SetEventValue(botGuid, "randomize", 1, 30 * MINUTE);
+        SetEventValue(botGuid, "teleport", 1, 30 * MINUTE);
+        SetEventValue(botGuid, "change_strategy", 1, 30 * MINUTE);
+    };
+
+    uint8 const targetLevel = ProofDungeonTargetLevel(dungeon);
+    std::vector<ProofDungeonBotCandidate> allianceCandidates;
+    std::vector<ProofDungeonBotCandidate> hordeCandidates;
+
+    for (uint32 accountId : rndBotTypeAccounts)
+    {
+        QueryResult results = CharacterDatabase.Query(
+            "SELECT guid, `class`, race, level, name FROM characters "
+            "WHERE account = {} ORDER BY guid",
+            accountId);
+
+        if (!results)
+            continue;
+
+        do
+        {
+            Field* fields = results->Fetch();
+            ProofDungeonBotCandidate candidate;
+            candidate.guid = fields[0].Get<uint32>();
+            candidate.cls = fields[1].Get<uint8>();
+            candidate.race = fields[2].Get<uint8>();
+            candidate.level = fields[3].Get<uint8>();
+            candidate.name = fields[4].Get<std::string>();
+
+            if (sPlayerbotAIConfig.disableDeathKnightLogin && candidate.cls == CLASS_DEATH_KNIGHT)
+                continue;
+
+            uint32 const activeProofDungeon = GetEventValue(candidate.guid, "proof_dungeon");
+            uint32 const activeProofRun = GetEventValue(candidate.guid, "proof_run");
+            if (activeProofDungeon && activeProofRun != runId)
+                continue;
+
+            Player* bot = GetPlayerBot(candidate.guid);
+            if (bot && bot->GetGroup() && !bot->GetGroup()->isLFGGroup())
+                continue;
+
+            if (IsAlliance(candidate.race))
+                allianceCandidates.push_back(candidate);
+            else
+                hordeCandidates.push_back(candidate);
+        } while (results->NextRow());
+    }
+
+    auto selectProofCandidates = [groupSize, &requestedClasses](std::vector<ProofDungeonBotCandidate>& pool,
+                                                                std::vector<ProofDungeonBotCandidate>& selected) -> bool
+    {
+        std::sort(pool.begin(), pool.end(),
+                  [](ProofDungeonBotCandidate const& left, ProofDungeonBotCandidate const& right)
+                  {
+                      return left.guid < right.guid;
+                  });
+
+        if (requestedClasses.empty())
+        {
+            if (pool.size() < groupSize)
+                return false;
+
+            selected.assign(pool.begin(), pool.begin() + groupSize);
+            return true;
+        }
+
+        std::vector<bool> used(pool.size(), false);
+        for (uint8 requestedClass : requestedClasses)
+        {
+            bool found = false;
+            for (uint32 i = 0; i < pool.size(); ++i)
+            {
+                if (used[i] || pool[i].cls != requestedClass)
+                    continue;
+
+                selected.push_back(pool[i]);
+                used[i] = true;
+                found = true;
+                break;
+            }
+
+            if (!found)
+                return false;
+        }
+
+        return selected.size() == groupSize;
+    };
+
+    std::vector<ProofDungeonBotCandidate> selectedCandidates;
+    bool selectedPool = selectProofCandidates(allianceCandidates, selectedCandidates);
+    if (!selectedPool)
+    {
+        selectedCandidates.clear();
+        selectedPool = selectProofCandidates(hordeCandidates, selectedCandidates);
+    }
+
+    if (!selectedPool)
+    {
+        handler->PSendSysMessage("Not enough same-faction RNDbots for {} group size {} classes {}. Alliance={}, Horde={}.",
+                                 dungeon->name, groupSize,
+                                 ProofClassList(requestedClasses),
+                                 allianceCandidates.size(), hordeCandidates.size());
+        LOG_WARN("playerbots",
+                 "PLAYERBOTS_PROOF_DUNGEON insufficient_candidates run={} dungeon={} map={} size={} classes={} target_level={} alliance={} horde={}",
+                 runId, dungeon->id, dungeon->map, groupSize, ProofClassList(requestedClasses), targetLevel,
+                 allianceCandidates.size(), hordeCandidates.size());
+        return false;
+    }
+
+    std::vector<Player*> onlineBots;
+    uint32 pendingLogins = 0;
+    for (uint32 i = 0; i < groupSize; ++i)
+    {
+        ProofDungeonBotCandidate const& candidate = selectedCandidates.at(i);
+        ObjectGuid guid = ObjectGuid::Create<HighGuid::Player>(candidate.guid);
+        Player* bot = GetPlayerBot(candidate.guid);
+
+        SetEventValue(candidate.guid, "proof_dungeon", dungeon->id, 30 * MINUTE,
+                      "map=" + std::to_string(dungeon->map) + " run=" + std::to_string(runId) +
+                          " size=" + std::to_string(groupSize));
+        SetEventValue(candidate.guid, "proof_run", runId, 30 * MINUTE);
+        holdProofDungeonBot(candidate.guid);
+
+        if (!bot)
+        {
+            SetEventValue(candidate.guid, "add", 1, sPlayerbotAIConfig.permanentlyInWorldTime);
+            SetEventValue(candidate.guid, "logout", 0, 0);
+            AddPlayerBot(guid, 0);
+            bot = GetPlayerBot(candidate.guid);
+
+            if (!bot)
+            {
+                ++pendingLogins;
+                LOG_INFO("playerbots",
+                         "PLAYERBOTS_PROOF_DUNGEON login_requested run={} dungeon={} map={} size={} bot_guid={} bot_name={} class={} level={} target_level={} prepared=pending",
+                         runId, dungeon->id, dungeon->map, groupSize, candidate.guid, candidate.name,
+                         uint32(candidate.cls), candidate.level, targetLevel);
+                continue;
+            }
+
+            LOG_INFO("playerbots",
+                     "PLAYERBOTS_PROOF_DUNGEON login_requested run={} dungeon={} map={} size={} bot_guid={} bot_name={} class={} level={} target_level={} prepared=immediate",
+                     runId, dungeon->id, dungeon->map, groupSize, candidate.guid, candidate.name,
+                     uint32(candidate.cls), candidate.level, targetLevel);
+        }
+
+        uint8 const oldLevel = bot->GetLevel();
+        bool const levelAdjusted = PrepareProofDungeonBot(bot, targetLevel);
+        holdProofDungeonBot(candidate.guid);
+        LOG_INFO("playerbots",
+                 "PLAYERBOTS_PROOF_DUNGEON prepared run={} dungeon={} map={} size={} bot_guid={} bot_name={} class={} old_level={} target_level={} new_level={} level_adjusted={}",
+                 runId, dungeon->id, dungeon->map, groupSize, candidate.guid, bot->GetName(),
+                 uint32(bot->getClass()), oldLevel, targetLevel, bot->GetLevel(), levelAdjusted ? "yes" : "no");
+        onlineBots.push_back(bot);
+    }
+
+    if (onlineBots.size() < groupSize)
+    {
+        handler->PSendSysMessage("Proof dungeon {} selected {} bots; {} login(s) pending. Re-run this command after bot login completes.",
+                                 dungeon->name, groupSize, pendingLogins);
+        LOG_INFO("playerbots",
+                 "PLAYERBOTS_PROOF_DUNGEON pending run={} dungeon={} map={} size={} target_level={} online={} pending={}",
+                 runId, dungeon->id, dungeon->map, groupSize, targetLevel, onlineBots.size(), pendingLogins);
+        return true;
+    }
+
+    std::vector<Group*> staleProofGroups;
+    for (Player* bot : onlineBots)
+    {
+        Group* currentGroup = bot->GetGroup();
+        if (currentGroup && currentGroup->isLFGGroup() &&
+            std::find(staleProofGroups.begin(), staleProofGroups.end(), currentGroup) == staleProofGroups.end())
+        {
+            staleProofGroups.push_back(currentGroup);
+        }
+    }
+
+    for (Group* staleGroup : staleProofGroups)
+    {
+        LOG_INFO("playerbots",
+                 "PLAYERBOTS_PROOF_DUNGEON group_reset run={} dungeon={} map={} size={} old_group={} members={}",
+                 runId, dungeon->id, dungeon->map, groupSize, staleGroup->GetGUID().ToString(), staleGroup->GetMembersCount());
+        staleGroup->Disband(true);
+    }
+
+    Group* group = onlineBots.front()->GetGroup();
+    if (!group && groupSize > 1)
+    {
+        group = new Group();
+        if (!group->Create(onlineBots.front()))
+        {
+            delete group;
+            handler->PSendSysMessage("Failed to create proof dungeon group.");
+            return false;
+        }
+        sGroupMgr->AddGroup(group);
+    }
+
+    if (group)
+    {
+        for (Player* bot : onlineBots)
+        {
+            uint8 role = ProofRoleForBot(bot);
+            if (bot->GetGroup() != group)
+                group->AddMember(bot, role);
+        }
+
+        group->SetDungeonDifficulty(Difficulty(dungeon->difficulty));
+    }
+
+    for (Player* bot : onlineBots)
+        bot->SetDungeonDifficulty(Difficulty(dungeon->difficulty));
+
+    LfgDungeons[onlineBots.front()->GetTeamId()].clear();
+    LfgDungeons[onlineBots.front()->GetTeamId()].push_back(dungeon->id);
+    LOG_INFO("playerbots",
+             "PLAYERBOTS_PROOF_DUNGEON lfg_candidate_seeded run={} dungeon={} map={} team={} size={} classes={} target_level={}",
+             runId, dungeon->id, dungeon->map, onlineBots.front()->GetTeamId(), groupSize,
+             ProofClassList(requestedClasses), targetLevel);
+
+    for (Player* bot : onlineBots)
+    {
+        sInstanceSaveMgr->PlayerCreateBoundInstancesMaps(bot->GetGUID());
+        for (uint8 difficulty = 0; difficulty < MAX_DIFFICULTY; ++difficulty)
+            sInstanceSaveMgr->PlayerUnbindInstanceNotExtended(bot->GetGUID(), dungeon->map, Difficulty(difficulty), bot);
+    }
+
+    bool placementOk = true;
+    uint32 proofInstance = 0;
+    InstanceSave* proofInstanceSave = nullptr;
+    for (uint32 i = 0; i < onlineBots.size(); ++i)
+    {
+        Player* bot = onlineBots[i];
+        uint8 role = ProofRoleForBot(bot);
+        sLFGMgr->SetRoles(bot->GetGUID(), role);
+
+        if (i > 0 && proofInstanceSave)
+            sInstanceSaveMgr->PlayerBindToInstance(bot->GetGUID(), proofInstanceSave, false, bot);
+
+        float const offset = static_cast<float>(i) * 1.5f;
+        bool const teleported = bot->TeleportTo(dungeon->map, dungeon->x + offset, dungeon->y, dungeon->z, dungeon->o);
+        if (teleported)
+            if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot))
+                botAI->HandleTeleportAck();
+        holdProofDungeonBot(bot->GetGUID().GetCounter());
+        if (teleported)
+            bot->SaveToDB(false, false);
+        if (!teleported)
+            placementOk = false;
+        if (i == 0)
+        {
+            proofInstance = bot->GetInstanceId();
+            proofInstanceSave = proofInstance ? sInstanceSaveMgr->GetInstanceSave(proofInstance) : nullptr;
+            if (proofInstanceSave)
+                for (Player* proofBot : onlineBots)
+                    sInstanceSaveMgr->PlayerBindToInstance(proofBot->GetGUID(), proofInstanceSave, false, proofBot);
+        }
+        else if (groupSize > 1 && bot->GetInstanceId() != proofInstance)
+            placementOk = false;
+        LOG_INFO("playerbots",
+                 "PLAYERBOTS_PROOF_DUNGEON placed run={} dungeon={} dungeon_name='{}' map={} instance={} size={} target_level={} group={} bot_guid={} bot_name={} class={} level={} role={} x={} y={} z={} teleport={}",
+                 runId, dungeon->id, dungeon->name, dungeon->map, bot->GetInstanceId(), groupSize,
+                 targetLevel,
+                 group ? group->GetGUID().ToString() : "solo", bot->GetGUID().GetCounter(), bot->GetName(),
+                 uint32(bot->getClass()), bot->GetLevel(), ProofRoleName(role), dungeon->x + offset, dungeon->y, dungeon->z,
+                 teleported ? "ok" : "failed");
+    }
+
+    if (!placementOk)
+    {
+        handler->PSendSysMessage("Proof dungeon {} placement failed for run {}: teleport failed or group instance split. Check PLAYERBOTS_PROOF_DUNGEON placement_failed logs.",
+                                 dungeon->name, runId);
+        LOG_WARN("playerbots",
+                 "PLAYERBOTS_PROOF_DUNGEON placement_failed run={} dungeon={} dungeon_name='{}' map={} size={} expected_instance={} bots={}",
+                 runId, dungeon->id, dungeon->name, dungeon->map, groupSize, proofInstance, onlineBots.size());
+        return false;
+    }
+
+    if (group)
+    {
+        if (!group->isLFGGroup())
+            group->ConvertToLFG(false);
+
+        for (Player* bot : onlineBots)
+            group->SetLfgRoles(bot->GetGUID(), ProofRoleForBot(bot));
+
+        sLFGMgr->SetDungeon(group->GetGUID(), dungeon->Entry());
+        sLFGMgr->SetLeader(group->GetGUID(), onlineBots.front()->GetGUID());
+    }
+
+    handler->PSendSysMessage("Proof dungeon {} ready: run={}, lfgId={}, map={}, groupSize={}, targetLevel={}, onlineBots={}.",
+                             dungeon->name, runId, dungeon->id, dungeon->map, groupSize, targetLevel, onlineBots.size());
+    LOG_INFO("playerbots",
+             "PLAYERBOTS_PROOF_DUNGEON ready run={} dungeon={} dungeon_name='{}' map={} size={} classes={} target_level={} group={} bots={}",
+             runId, dungeon->id, dungeon->name, dungeon->map, groupSize, ProofClassList(requestedClasses),
+             targetLevel,
+             group ? group->GetGUID().ToString() : "solo", onlineBots.size());
+    return true;
+}
