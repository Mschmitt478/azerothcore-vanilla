+struct ProofDungeonBotCandidate
+{
+    ObjectGuid::LowType guid = 0;
+    uint8 cls = 0;
+    uint8 race = 0;
+    uint8 level = 0;
+    std::string name;
+};
+
+struct ProofCrawlPoint
+{
+    float x = 0.0f;
+    float y = 0.0f;
+    float z = 0.0f;
+};
+
+std::string ProofLower(std::string value)
+{
+    std::transform(value.begin(), value.end(), value.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    value.erase(std::remove_if(value.begin(), value.end(), [](unsigned char c) { return !std::isalnum(c); }),
+                value.end());
+    return value;
+}
+
+uint32 ParseProofRunId(std::string const& token)
+{
+    std::string lowered = token;
+    std::transform(lowered.begin(), lowered.end(), lowered.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+
+    std::string value;
+    if (lowered.rfind("run=", 0) == 0 || lowered.rfind("run:", 0) == 0)
+        value = lowered.substr(4);
+    else if (lowered.rfind("run", 0) == 0 && lowered.size() > 3 && std::isdigit(static_cast<unsigned char>(lowered[3])))
+        value = lowered.substr(3);
+    else
+        return 0;
+
+    return uint32(std::strtoul(value.c_str(), nullptr, 10));
+}
+
+uint8 ProofClassId(std::string const& token)
+{
+    std::string const lowered = ProofLower(token);
+    if (lowered == "warrior" || lowered == "warr")
+        return CLASS_WARRIOR;
+    if (lowered == "paladin" || lowered == "pally")
+        return CLASS_PALADIN;
+    if (lowered == "hunter")
+        return CLASS_HUNTER;
+    if (lowered == "rogue")
+        return CLASS_ROGUE;
+    if (lowered == "priest")
+        return CLASS_PRIEST;
+    if (lowered == "dk" || lowered == "deathknight")
+        return CLASS_DEATH_KNIGHT;
+    if (lowered == "shaman" || lowered == "sham")
+        return CLASS_SHAMAN;
+    if (lowered == "mage")
+        return CLASS_MAGE;
+    if (lowered == "warlock" || lowered == "lock")
+        return CLASS_WARLOCK;
+    if (lowered == "druid")
+        return CLASS_DRUID;
+    return 0;
+}
+
+std::string ProofClassList(std::vector<uint8> const& classes)
+{
+    if (classes.empty())
+        return "any";
+
+    std::ostringstream out;
+    for (uint32 i = 0; i < classes.size(); ++i)
+    {
+        if (i)
+            out << ",";
+        out << uint32(classes[i]);
+    }
+    return out.str();
+}
+
+uint32 ProofDungeonAliasMap(std::string const& token)
+{
+    if (token == "rfc" || token == "ragefire" || token == "ragefirechasm")
+        return 389;
+
+    if (token == "vc" || token == "dm" || token == "deadmines" || token == "thedeadmines")
+        return 36;
+
+    return 0;
+}
+
+lfg::LFGDungeonData const* ResolveProofDungeon(std::string const& token)
+{
+    if (token.empty())
+        return nullptr;
+
+    std::string const lowered = ProofLower(token);
+    uint32 const numeric = uint32(std::strtoul(lowered.c_str(), nullptr, 10));
+
+    if (numeric)
+    {
+        if (numeric == 36 || numeric == 389)
+            if (LFGDungeonEntry const* entry = GetLFGDungeon(numeric, DUNGEON_DIFFICULTY_NORMAL))
+                return sLFGMgr->GetLFGDungeon(entry->ID);
+
+        if (lfg::LFGDungeonData const* dungeon = sLFGMgr->GetLFGDungeon(numeric))
+            return dungeon;
+
+        if (LFGDungeonEntry const* entry = GetLFGDungeon(numeric, DUNGEON_DIFFICULTY_NORMAL))
+            return sLFGMgr->GetLFGDungeon(entry->ID);
+    }
+
+    if (uint32 const mapId = ProofDungeonAliasMap(lowered))
+        if (LFGDungeonEntry const* entry = GetLFGDungeon(mapId, DUNGEON_DIFFICULTY_NORMAL))
+            return sLFGMgr->GetLFGDungeon(entry->ID);
+
+    for (LFGDungeonEntry const* entry : sLFGDungeonStore)
+    {
+        if (!entry)
+            continue;
+
+        if (ProofLower(entry->Name[0]) == lowered)
+            return sLFGMgr->GetLFGDungeon(entry->ID);
+    }
+
+    return nullptr;
+}
+
+uint8 ProofRoleForBot(Player* bot)
+{
+    uint8 spec = AiFactory::GetPlayerSpecTab(bot);
+    switch (bot->getClass())
+    {
+        case CLASS_DRUID:
+            return spec == 2 ? lfg::PLAYER_ROLE_HEALER :
+                   spec == 1 && bot->HasAura(16931) ? lfg::PLAYER_ROLE_TANK : lfg::PLAYER_ROLE_DAMAGE;
+        case CLASS_PALADIN:
+            return spec == 1 ? lfg::PLAYER_ROLE_TANK : !spec ? lfg::PLAYER_ROLE_HEALER : lfg::PLAYER_ROLE_DAMAGE;
+        case CLASS_PRIEST:
+            return spec != 2 ? lfg::PLAYER_ROLE_HEALER : lfg::PLAYER_ROLE_DAMAGE;
+        case CLASS_SHAMAN:
+            return spec == 2 ? lfg::PLAYER_ROLE_HEALER : lfg::PLAYER_ROLE_DAMAGE;
+        case CLASS_WARRIOR:
+            return spec == 2 ? lfg::PLAYER_ROLE_TANK : lfg::PLAYER_ROLE_DAMAGE;
+        case CLASS_DEATH_KNIGHT:
+            return spec == 0 ? lfg::PLAYER_ROLE_TANK : lfg::PLAYER_ROLE_DAMAGE;
+        default:
+            return lfg::PLAYER_ROLE_DAMAGE;
+    }
+}
+
+uint8 ProofDungeonTargetLevel(lfg::LFGDungeonData const* dungeon)
+{
+    uint32 const configuredLevel = dungeon->maxlevel ? dungeon->maxlevel : dungeon->minlevel;
+    return static_cast<uint8>(std::min<uint32>(DEFAULT_MAX_LEVEL, std::max<uint32>(1, configuredLevel)));
+}
+
+bool PrepareProofDungeonBot(Player* bot, uint8 targetLevel)
+{
+    uint8 const oldLevel = bot->GetLevel();
+    if (oldLevel == targetLevel)
+    {
+        if (bot->isDead())
+            bot->ResurrectPlayer(1.0f, false);
+
+        bot->CombatStop(true);
+        bot->SetFullHealth();
+        bot->SetPower(POWER_MANA, bot->GetMaxPower(POWER_MANA));
+        return false;
+    }
+
+    PlayerbotFactory factory(bot, targetLevel);
+    factory.Randomize(false);
+    return true;
+}
+
+char const* ProofRoleName(uint8 role)
+{
+    if (role & lfg::PLAYER_ROLE_TANK)
+        return "tank";
+    if (role & lfg::PLAYER_ROLE_HEALER)
+        return "heal";
+    return "dps";
+}
+
+std::vector<ProofCrawlPoint> ProofCrawlPath(uint32 mapId)
+{
+    if (mapId == 36)
+    {
+        return {
+            {-30.0f, -376.0f, 58.0f},
+            {-42.0f, -373.0f, 56.5f},
+            {-55.0f, -384.0f, 55.0f},
+            {-70.0f, -394.0f, 56.0f},
+            {-86.0f, -402.0f, 59.0f},
+        };
+    }
+
+    if (mapId == 389)
+    {
+        return {
+            {-12.0f, -45.0f, -21.5f},
+            {-28.0f, -50.0f, -21.5f},
+            {-42.0f, -34.0f, -21.0f},
+            {-62.0f, -34.0f, -19.0f},
+            {-86.0f, -40.0f, -24.0f},
+        };
+    }
+
+    return {};
+}
+
+char const* ProofBool(bool value)
+{
+    return value ? "yes" : "no";
+}
+
+Unit* FindProofPullTarget(std::vector<Player*> const& proofBots, float range, Player*& finder)
+{
+    Unit* bestTarget = nullptr;
+    float bestDistance = range;
+    finder = nullptr;
+
+    for (Player* bot : proofBots)
+    {
+        if (!bot || !bot->IsInWorld() || !bot->IsAlive())
+            continue;
+
+        std::list<Unit*> targets;
+        Acore::AnyUnfriendlyUnitInObjectRangeCheck check(bot, bot, range);
+        Acore::UnitListSearcher<Acore::AnyUnfriendlyUnitInObjectRangeCheck> searcher(bot, targets, check);
+        Cell::VisitObjects(bot, searcher, range);
+
+        for (Unit* target : targets)
+        {
+            if (!target || !target->IsInWorld() || !target->IsAlive() || target->IsPlayer())
+                continue;
+
+            if (target->GetMapId() != bot->GetMapId() || !bot->IsValidAttackTarget(target) ||
+                !bot->IsWithinLOSInMap(target))
+                continue;
+
+            float const distance = bot->GetDistance(target);
+            if (!bestTarget || distance < bestDistance)
+            {
+                bestTarget = target;
+                bestDistance = distance;
+                finder = bot;
+            }
+        }
+    }
+
+    return bestTarget;
+}
+}
