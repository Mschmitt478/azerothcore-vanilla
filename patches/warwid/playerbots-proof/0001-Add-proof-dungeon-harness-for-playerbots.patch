+bool RandomPlayerbotMgr::HandleProofCrawlCommand(ChatHandler* handler, std::string const& args)
+{
+    if (!sPlayerbotAIConfig.proofDungeonCommand)
+    {
+        handler->PSendSysMessage("Proof crawl command is disabled. Set AiPlayerbot.ProofDungeonCommand = 1 in this proof tree.");
+        LOG_WARN("playerbots", "PLAYERBOTS_PROOF_CRAWL disabled args='{}'", args);
+        return false;
+    }
+
+    std::istringstream input(args);
+    std::string dungeonToken;
+    std::string stepToken;
+    input >> dungeonToken >> stepToken;
+    uint32 runId = 0;
+
+    if (ParseProofRunId(stepToken))
+    {
+        runId = ParseProofRunId(stepToken);
+        input >> stepToken;
+    }
+
+    if (dungeonToken.empty() || stepToken.empty())
+    {
+        handler->PSendSysMessage("Usage: playerbots rndbot proofcrawl <rfc|deadmines|lfgId|mapId|name> [run=<id>] <status|pull|steps 1-5>");
+        return false;
+    }
+
+    lfg::LFGDungeonData const* dungeon = ResolveProofDungeon(dungeonToken);
+    if (!dungeon)
+    {
+        handler->PSendSysMessage("Proof crawl dungeon '{}' was not found in LFG dungeon data.", dungeonToken);
+        LOG_WARN("playerbots", "PLAYERBOTS_PROOF_CRAWL missing_dungeon token='{}'", dungeonToken);
+        return false;
+    }
+
+    std::vector<Player*> proofBots;
+    for (PlayerBotMap::const_iterator it = GetPlayerBotsBegin(); it != GetPlayerBotsEnd(); ++it)
+    {
+        Player* bot = it->second;
+        if (!bot || !bot->IsInWorld())
+            continue;
+
+        ObjectGuid::LowType const botGuid = bot->GetGUID().GetCounter();
+        if (GetEventValue(botGuid, "proof_dungeon") != dungeon->id)
+            continue;
+        if (GetEventValue(botGuid, "proof_run") != runId)
+            continue;
+
+        proofBots.push_back(bot);
+    }
+
+    std::sort(proofBots.begin(), proofBots.end(),
+              [](Player const* left, Player const* right)
+              {
+                  return left->GetGUID().GetCounter() < right->GetGUID().GetCounter();
+              });
+
+    if (proofBots.empty())
+    {
+        handler->PSendSysMessage("No online proof bots are staged for {} run {}. Run proofdungeon first.", dungeon->name, runId);
+        LOG_WARN("playerbots", "PLAYERBOTS_PROOF_CRAWL no_bots run={} dungeon={} map={}", runId, dungeon->id, dungeon->map);
+        return false;
+    }
+
+    auto holdProofDungeonBot = [this](ObjectGuid::LowType botGuid)
+    {
+        SetEventValue(botGuid, "randomize", 1, 30 * MINUTE);
+        SetEventValue(botGuid, "teleport", 1, 30 * MINUTE);
+        SetEventValue(botGuid, "change_strategy", 1, 30 * MINUTE);
+    };
+
+    if (stepToken == "status")
+    {
+        for (Player* bot : proofBots)
+        {
+            LOG_INFO("playerbots",
+                     "PLAYERBOTS_PROOF_CRAWL status run={} dungeon={} dungeon_name='{}' map={} instance={} bot_guid={} bot_name={} class={} level={} x={} y={} z={} combat={} dead={} health_pct={}",
+                     runId, dungeon->id, dungeon->name, dungeon->map, bot->GetInstanceId(),
+                     bot->GetGUID().GetCounter(), bot->GetName(), uint32(bot->getClass()), bot->GetLevel(), bot->GetPositionX(), bot->GetPositionY(),
+                     bot->GetPositionZ(), ProofBool(bot->IsInCombat()), ProofBool(bot->isDead()),
+                     uint32(bot->GetHealthPct()));
+        }
+        handler->PSendSysMessage("Proof crawl status logged for {} bot(s) in {} run {}.", proofBots.size(), dungeon->name, runId);
+        return true;
+    }
+
+    if (stepToken == "pull")
+    {
+        Player* finder = nullptr;
+        Unit* target = FindProofPullTarget(proofBots, sPlayerbotAIConfig.reactDistance * 3.0f, finder);
+        if (!target)
+        {
+            handler->PSendSysMessage("Proof crawl {} run {} found no nearby hostile target to pull.", dungeon->name, runId);
+            LOG_WARN("playerbots",
+                     "PLAYERBOTS_PROOF_CRAWL pull_no_target run={} dungeon={} dungeon_name='{}' map={} bots={}",
+                     runId, dungeon->id, dungeon->name, dungeon->map, proofBots.size());
+            return false;
+        }
+
+        ObjectGuid const targetGuid = target->GetGUID();
+        std::string const targetName = target->GetName();
+        uint32 const targetEntry = target->GetEntry();
+        float const targetX = target->GetPositionX();
+        float const targetY = target->GetPositionY();
+        float const targetZ = target->GetPositionZ();
+        uint32 const targetHealthPct = uint32(target->GetHealthPct());
+
+        LOG_INFO("playerbots",
+                 "PLAYERBOTS_PROOF_CRAWL pull_target run={} dungeon={} dungeon_name='{}' map={} instance={} target_guid={} target_entry={} target_name='{}' target_level={} target_health_pct={} target_x={} target_y={} target_z={} finder_guid={} finder_name={}",
+                 runId, dungeon->id, dungeon->name, dungeon->map, target->GetInstanceId(), targetGuid.GetCounter(), targetEntry, targetName,
+                 target->GetLevel(), targetHealthPct, targetX, targetY, targetZ,
+                 finder ? finder->GetGUID().GetCounter() : 0, finder ? finder->GetName() : "none");
+
+        for (Player* bot : proofBots)
+        {
+            holdProofDungeonBot(bot->GetGUID().GetCounter());
+            bot->GetMotionMaster()->Clear();
+            bot->SetSelection(targetGuid);
+
+            bool attackIssued = false;
+            if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot))
+            {
+                botAI->GetAiObjectContext()->GetValue<Unit*>("current target")->Set(target);
+                botAI->GetAiObjectContext()->GetValue<ObjectGuid>("pull target")->Set(targetGuid);
+                botAI->GetAiObjectContext()->GetValue<ObjectGuid>("pull strategy target")->Set(targetGuid);
+                botAI->ChangeEngine(BOT_STATE_COMBAT);
+                bool const shouldMelee = bot->IsWithinMeleeRange(target) || PlayerbotAI::IsMelee(bot);
+                attackIssued = bot->Attack(target, shouldMelee);
+            }
+
+            LOG_INFO("playerbots",
+                     "PLAYERBOTS_PROOF_CRAWL pull_issued run={} dungeon={} dungeon_name='{}' map={} instance={} bot_guid={} bot_name={} class={} level={} target_guid={} target_entry={} target_name='{}' target_instance={} distance={} combat={} health_pct={} attack={}",
+                     runId, dungeon->id, dungeon->name, dungeon->map, bot->GetInstanceId(),
+                     bot->GetGUID().GetCounter(), bot->GetName(), uint32(bot->getClass()), bot->GetLevel(), targetGuid.GetCounter(), targetEntry,
+                     targetName, target->GetInstanceId(), bot->GetDistance(target), ProofBool(bot->IsInCombat()), uint32(bot->GetHealthPct()),
+                     attackIssued ? "ok" : "deferred");
+        }
+
+        handler->PSendSysMessage("Proof crawl {} run {} pull issued for {} bot(s) against {} (entry {}). Run status after it settles.",
+                                 dungeon->name, runId, proofBots.size(), targetName, targetEntry);
+        LOG_INFO("playerbots",
+                 "PLAYERBOTS_PROOF_CRAWL pull run={} dungeon={} dungeon_name='{}' map={} bots={} target_guid={} target_entry={} target_name='{}'",
+                 runId, dungeon->id, dungeon->name, dungeon->map, proofBots.size(), targetGuid.GetCounter(), targetEntry,
+                 targetName);
+        return true;
+    }
+
+    uint32 steps = uint32(std::strtoul(stepToken.c_str(), nullptr, 10));
+    std::vector<ProofCrawlPoint> path = ProofCrawlPath(dungeon->map);
+    if (!steps || steps > path.size())
+    {
+        handler->PSendSysMessage("Proof crawl '{}' supports steps 1-{}, pull, or status.", dungeon->name, path.size());
+        return false;
+    }
+
+    ProofCrawlPoint const& point = path[steps - 1];
+    for (uint32 i = 0; i < proofBots.size(); ++i)
+    {
+        Player* bot = proofBots[i];
+        holdProofDungeonBot(bot->GetGUID().GetCounter());
+
+        float const offset = static_cast<float>(i) * 1.5f;
+        bot->CombatStop(true);
+        bot->GetMotionMaster()->Clear();
+        bot->GetMotionMaster()->MovePoint(9000 + steps, point.x + offset, point.y, point.z);
+        LOG_INFO("playerbots",
+                 "PLAYERBOTS_PROOF_CRAWL move run={} dungeon={} dungeon_name='{}' map={} instance={} step={} bot_guid={} bot_name={} class={} level={} from_x={} from_y={} from_z={} to_x={} to_y={} to_z={}",
+                 runId, dungeon->id, dungeon->name, dungeon->map, bot->GetInstanceId(), steps, bot->GetGUID().GetCounter(), bot->GetName(),
+                 uint32(bot->getClass()), bot->GetLevel(), bot->GetPositionX(), bot->GetPositionY(),
+                 bot->GetPositionZ(), point.x + offset, point.y, point.z);
+    }
+
+    handler->PSendSysMessage("Proof crawl {} run {} step {} issued for {} bot(s). Run proofcrawl {} run={} status after it settles.",
+                             dungeon->name, runId, steps, proofBots.size(), dungeonToken, runId);
+    LOG_INFO("playerbots",
+             "PLAYERBOTS_PROOF_CRAWL issued run={} dungeon={} dungeon_name='{}' map={} step={} bots={}",
+             runId, dungeon->id, dungeon->name, dungeon->map, steps, proofBots.size());
+    return true;
+}
