From b6d1e316127cb9ccbbdaf7dbf0d41ad75f31e8d4 Mon Sep 17 00:00:00 2001
From: Matthew Schmitt <mschmitt478@gmail.com>
Date: Fri, 3 Jul 2026 21:20:24 -0400
Subject: [PATCH 4/4] Add proof crawl target outcome logging

---
 src/Bot/RandomPlayerbotMgr.cpp | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/Bot/RandomPlayerbotMgr.cpp b/src/Bot/RandomPlayerbotMgr.cpp
index 2c028984..f621fd95 100644
--- a/src/Bot/RandomPlayerbotMgr.cpp
+++ b/src/Bot/RandomPlayerbotMgr.cpp
@@ -266,6 +266,11 @@ std::vector<ProofCrawlPoint> ProofCrawlPath(uint32 mapId)
             {-55.0f, -384.0f, 55.0f},
             {-70.0f, -394.0f, 56.0f},
             {-86.0f, -402.0f, 59.0f},
+            {-100.0f, -412.0f, 60.0f},
+            {-116.0f, -418.0f, 60.0f},
+            {-134.0f, -423.0f, 59.0f},
+            {-152.0f, -420.0f, 58.0f},
+            {-170.0f, -412.0f, 57.0f},
         };
     }
 
@@ -3124,12 +3129,22 @@ bool RandomPlayerbotMgr::HandleProofCrawlCommand(ChatHandler* handler, std::stri
     {
         for (Player* bot : proofBots)
         {
+            Unit* selectedTarget = bot->GetSelectedUnit();
+            if (selectedTarget && selectedTarget->IsPlayer())
+                selectedTarget = nullptr;
+            ObjectGuid const targetGuid = selectedTarget ? selectedTarget->GetGUID() : ObjectGuid::Empty;
             LOG_INFO("playerbots",
-                     "PLAYERBOTS_PROOF_CRAWL status run={} dungeon={} dungeon_name='{}' map={} instance={} bot_guid={} bot_name={} class={} level={} x={} y={} z={} combat={} dead={} health_pct={}",
+                     "PLAYERBOTS_PROOF_CRAWL status run={} dungeon={} dungeon_name='{}' map={} instance={} bot_guid={} bot_name={} class={} level={} x={} y={} z={} combat={} dead={} health_pct={} target_guid={} target_visible={} target_entry={} target_name='{}' target_alive={} target_health_pct={} target_instance={} target_distance={}",
                      runId, dungeon->id, dungeon->name, dungeon->map, bot->GetInstanceId(),
                      bot->GetGUID().GetCounter(), bot->GetName(), uint32(bot->getClass()), bot->GetLevel(), bot->GetPositionX(), bot->GetPositionY(),
                      bot->GetPositionZ(), ProofBool(bot->IsInCombat()), ProofBool(bot->isDead()),
-                     uint32(bot->GetHealthPct()));
+                     uint32(bot->GetHealthPct()), targetGuid.GetCounter(), ProofBool(selectedTarget != nullptr),
+                     selectedTarget ? selectedTarget->GetEntry() : 0,
+                     selectedTarget ? selectedTarget->GetName() : "none",
+                     selectedTarget ? ProofBool(selectedTarget->IsAlive()) : "no",
+                     selectedTarget ? uint32(selectedTarget->GetHealthPct()) : 0,
+                     selectedTarget ? selectedTarget->GetInstanceId() : 0,
+                     selectedTarget ? bot->GetDistance(selectedTarget) : 0.0f);
         }
         handler->PSendSysMessage("Proof crawl status logged for {} bot(s) in {} run {}.", proofBots.size(), dungeon->name, runId);
         return true;
@@ -3165,6 +3180,8 @@ bool RandomPlayerbotMgr::HandleProofCrawlCommand(ChatHandler* handler, std::stri
         for (Player* bot : proofBots)
         {
             holdProofDungeonBot(bot->GetGUID().GetCounter());
+            SetEventValue(bot->GetGUID().GetCounter(), "proof_target", targetGuid.GetCounter(), 30 * MINUTE,
+                          fmt::format("entry={} name={}", targetEntry, targetName));
             bot->GetMotionMaster()->Clear();
             bot->SetSelection(targetGuid);
 
