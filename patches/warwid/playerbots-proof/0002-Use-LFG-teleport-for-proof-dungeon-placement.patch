From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthew Schmitt <mschmitt478@gmail.com>
Date: Fri, 3 Jul 2026 19:29:59 -0400
Subject: [PATCH 2/2] Use LFG teleport for proof dungeon placement


diff --git a/src/Bot/RandomPlayerbotMgr.cpp b/src/Bot/RandomPlayerbotMgr.cpp
index a390a4c561ff41564da016128040db9282f2b185..484c3204c634739c1c51f6aa11fbdaf0cc123236 100644
--- a/src/Bot/RandomPlayerbotMgr.cpp
+++ b/src/Bot/RandomPlayerbotMgr.cpp
@@ -2910,6 +2910,18 @@ bool RandomPlayerbotMgr::HandleProofDungeonCommand(ChatHandler* handler, std::st
     for (Player* bot : onlineBots)
         bot->SetDungeonDifficulty(Difficulty(dungeon->difficulty));
 
+    if (group)
+    {
+        if (!group->isLFGGroup())
+            group->ConvertToLFG(false);
+
+        for (Player* bot : onlineBots)
+            group->SetLfgRoles(bot->GetGUID(), ProofRoleForBot(bot));
+
+        sLFGMgr->SetDungeon(group->GetGUID(), dungeon->Entry());
+        sLFGMgr->SetLeader(group->GetGUID(), onlineBots.front()->GetGUID());
+    }
+
     LfgDungeons[onlineBots.front()->GetTeamId()].clear();
     LfgDungeons[onlineBots.front()->GetTeamId()].push_back(dungeon->id);
     LOG_INFO("playerbots",
@@ -2937,10 +2949,17 @@ bool RandomPlayerbotMgr::HandleProofDungeonCommand(ChatHandler* handler, std::st
             sInstanceSaveMgr->PlayerBindToInstance(bot->GetGUID(), proofInstanceSave, false, bot);
 
         float const offset = static_cast<float>(i) * 1.5f;
-        bool const teleported = bot->TeleportTo(dungeon->map, dungeon->x + offset, dungeon->y, dungeon->z, dungeon->o);
-        if (teleported)
+        WorldLocation teleportLocation(dungeon->map, dungeon->x + offset, dungeon->y, dungeon->z, dungeon->o);
+        if (group)
+            sLFGMgr->TeleportPlayer(bot, false, &teleportLocation);
+        else
+            bot->TeleportTo(dungeon->map, dungeon->x + offset, dungeon->y, dungeon->z, dungeon->o);
+
+        bool const teleportStarted = bot->IsBeingTeleported();
+        if (teleportStarted)
             if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot))
                 botAI->HandleTeleportAck();
+        bool const teleported = bot->GetMapId() == uint32(dungeon->map) && bot->GetInstanceId();
         holdProofDungeonBot(bot->GetGUID().GetCounter());
         if (teleported)
             bot->SaveToDB(false, false);
@@ -2975,18 +2994,6 @@ bool RandomPlayerbotMgr::HandleProofDungeonCommand(ChatHandler* handler, std::st
         return false;
     }
 
-    if (group)
-    {
-        if (!group->isLFGGroup())
-            group->ConvertToLFG(false);
-
-        for (Player* bot : onlineBots)
-            group->SetLfgRoles(bot->GetGUID(), ProofRoleForBot(bot));
-
-        sLFGMgr->SetDungeon(group->GetGUID(), dungeon->Entry());
-        sLFGMgr->SetLeader(group->GetGUID(), onlineBots.front()->GetGUID());
-    }
-
     handler->PSendSysMessage("Proof dungeon {} ready: run={}, lfgId={}, map={}, groupSize={}, targetLevel={}, onlineBots={}.",
                              dungeon->name, runId, dungeon->id, dungeon->map, groupSize, targetLevel, onlineBots.size());
     LOG_INFO("playerbots",
